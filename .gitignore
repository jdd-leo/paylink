# Dependências
node_modules/

# Variáveis de ambiente (manter apenas os .env.example)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operacional / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------- Backend (NestJS) ----------
backend/dist/
backend/build/
backend/coverage/
backend/*.tsbuildinfo
backend/.eslintcache
# Uploads enviados pelos usuários (mantém a pasta versionada)
backend/uploads/*
!backend/uploads/.gitkeep

# ---------- Frontend (Vite/React) ----------
frontend/dist/
frontend/build/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/.vite/
frontend/node_modules/.vite/
